#
# Standalone NuttX NSH configuration for PIC32CZ CA90 Curiosity Ultra.
# This config is NOT used by the PX4 build — PX4 uses
# boards/microchip/czca90curiosity/nuttx-config/nsh/defconfig.
# Keep critical values (RAM map, stack sizes, clock/UART) in sync.
#

# Architecture
CONFIG_ARCH="arm"
CONFIG_ARCH_ARM=y
CONFIG_ARCH_CHIP="pic32czca90"
CONFIG_ARCH_CHIP_PIC32CZCA90=y
CONFIG_ARCH_CORTEXM7=y
CONFIG_ARCH_FPU=y
CONFIG_ARCH_DPFPU=y
CONFIG_ARMV7M_DCACHE=y
CONFIG_ARMV7M_DCACHE_WRITETHROUGH=y
CONFIG_ARMV7M_ICACHE=y
# CONFIG_ARMV7M_DTCM is not set — TCM is disabled; SRAM starts at 0x20020000
CONFIG_ARM_MPU=y
CONFIG_ARM_MPU_NREGIONS=16
CONFIG_ARM_MPU_EARLY_RESET=y

# Memory map — SRAM 832 KB at 0x20020000 + 64 KB nocache at 0x200F0000 = 896 KB
CONFIG_RAM_START=0x20020000
CONFIG_RAM_SIZE=917504
CONFIG_MM_REGIONS=1

# Boot
CONFIG_BOOT_RUNFROMFLASH=y

# Board
CONFIG_ARCH_BOARD="pic32czca90-curiosity"
CONFIG_ARCH_BOARD_PIC32CZCA90_CURIOSITY=y
CONFIG_BOARD_LOOPSPERMSEC=100000

# Stack sizes — idle stack carries the full boot sequence; keep generous
CONFIG_IDLETHREAD_STACKSIZE=8192
CONFIG_INIT_STACKSIZE=8192
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_PTHREAD_STACK_MIN=2048
CONFIG_PTHREAD_STACK_DEFAULT=4096

# Stack debug
CONFIG_ARCH_STACKDUMP=y
CONFIG_STACK_COLORATION=y

# SERCOM / USART
CONFIG_PIC32CZCA90_SERCOM1=y
CONFIG_PIC32CZCA90_SERCOM1_ISUSART=y

# Console on SERCOM1 (USART1) — PKoB4 VCP J700, PC04 TX / PC07 RX, func D
CONFIG_USART1_SERIALDRIVER=y
CONFIG_USART1_SERIAL_CONSOLE=y
CONFIG_USART1_RXBUFSIZE=256
CONFIG_USART1_TXBUFSIZE=256
CONFIG_USART1_BAUD=115200
CONFIG_USART1_BITS=8
CONFIG_USART1_PARITY=0
CONFIG_USART1_2STOP=0

# Serial driver
CONFIG_DEV_CONSOLE=y

# System
CONFIG_START_YEAR=2026
CONFIG_START_MONTH=3
CONFIG_START_DAY=28
CONFIG_USEC_PER_TICK=1000
# CONFIG_SYSTEMTICK_EXTCLK is not set — SysTick used (sam_timerisr.c)
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
CONFIG_INIT_ENTRYPOINT="nsh_main"

# NSH
CONFIG_NSH_CONSOLE=y
CONFIG_NSH_READLINE=y
CONFIG_SYSTEM_NSH=y
CONFIG_NSH_ARCHINIT=y

# File system
CONFIG_FS_PROCFS=y

# C library
CONFIG_LIBC_FLOATINGPOINT=y

# Debug
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_WARN=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_HARDFAULT_ALERT=y

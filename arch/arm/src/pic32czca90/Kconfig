endmenu # PIC32CZ CA90 Peripheral Support

menu "SERCOM Configuration"
	depends on PIC32CZCA90_SERCOM

choice
	prompt "SERCOM0 mode"
	default PIC32CZCA90_SERCOM0_ISUSART
	depends on PIC32CZCA90_SERCOM0

config PIC32CZCA90_SERCOM0_ISI2C

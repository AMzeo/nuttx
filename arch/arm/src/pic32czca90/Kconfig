comment "Microchip PIC32CZ CA90 Configuration Options"

menu "PIC32CZ CA90 Peripheral Support"

config PIC32CZCA90_SERCOM
	bool
	default n

config PIC32CZCA90_DMAC
	bool "DMA Controller"
	default n
	select ARCH_DMA

config PIC32CZCA90_SERCOM0
	bool "Serial Communication Interface 0"
	default n
	select PIC32CZCA90_SERCOM

config PIC32CZCA90_SERCOM1
	bool "Serial Communication Interface 1"
	default n
	select PIC32CZCA90_SERCOM

